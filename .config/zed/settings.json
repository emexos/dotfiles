// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "sticky_scroll": {
    "enabled": false
  },
  "rounded_selection": false,
  "text_rendering_mode": "platform_default",
  "auto_update": true,
  "use_system_path_prompts": true,
  "proxy": "",
  "disable_ai": true,
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "focus_follows_mouse": {
    "enabled": false
  },
  "centered_layout": {
    "left_padding": 0.2
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_project_panel": true,
    "enabled": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "close:minimize,maximize",
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": false
  },
  "prettier": {
    "parser": "",
    "allowed": false
  },
  "helix_mode": false,
  "autoscroll_on_clicks": false,
  "ui_font_weight": 100.0,
  "buffer_line_height": "standard",
  "buffer_font_weight": 100.0,
  "agent": {
    "dock": "right",
    "flexible": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "terminal": {
    "show_count_badge": false,
    "flexible": true,
    "dock": "bottom",
    "font_family": "Departure Mono",
    //"font_family": "Courier New",
    "font_weight": 100.0,
    "button": false
  },
  "status_bar": {
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "active_language_button": true
  },
  "edit_predictions": {
    "provider": "none",
  },
  "git_panel": {
    "dock": "left",
    "button": false,
  },
  "outline_panel": {
    "file_icons": true,
    "dock": "left",
    "auto_fold_dirs": false,
    "folder_icons": true,
    "button": false,
    "git_status": false,
  },
  "project_panel": {
    "auto_open": {
      "on_create": true
    },
    "hide_hidden": false,
    "sort_mode": "directories_first",
    "drag_and_drop": true,
    "sticky_scroll": true,
    "scrollbar": {
      "horizontal_scroll": true,
      "show": "never"
    },
    "starts_open": true,
    "auto_reveal_entries": true,
    "indent_size": 20.0,
    "entry_spacing": "standard",
    "file_icons": true,
    "dock": "left",
    "show_diagnostics": "off",
    "hide_root": true,
    "bold_folder_labels": false,
    "auto_fold_dirs": false,
    "folder_icons": false,
    "diagnostic_badges": false,
    "button": true,
    "git_status": true,
  },
  "tabs": {
    "show_diagnostics": "off",
    "show_close_button": "hover",
    "close_position": "right",
    "git_status": false,
  },
  "file_finder": {
    "git_status": true,
  },
  "auto_update_extensions": {
    "assembly": false,
    "html": false,
    "nvim-nightfox": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Ton Dark Theme",
    "dark": "Zed (Default)"
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "ui_font_family": "Departure Mono",
  //"ui_font_family": "Courier New",
  //"buffer_font_family": "Courier New",
  "buffer_font_family": "Departure Mono",
  //"ui_font_family": "GohuFont",
  //"buffer_font_family": "GohuFont",
  //"ui_font_family": "Geneva",
  //"buffer_font_family": "Hack Nerd Font Mono",
  "ui_font_size": 18,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    //"dark": "Base16 Gruvbox dark, medium"
    //"dark": "Base16 Everforest"
    //"dark": "Base16 Eighties"
    //"dark": "Snazzy Theme - blurred"
    //"dark": "Snazzy Theme"
    //"dark": "One Dark"
    "dark": "Vesper Blur",
  },
  "workbench.status_bar.visible": false,
  "workbench.activity_bar.visible": false,
  "workbench.title_bar.visible": false,
  "editor.minimap.enabled": false,
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": true,
    "visible": false,
  },
}
